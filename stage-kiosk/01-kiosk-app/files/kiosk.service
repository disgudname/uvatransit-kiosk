[Unit]
Description=Kiosk display (X11 + Chromium)
After=network.target systemd-user-sessions.service getty@tty1.service plymouth-quit.service
Conflicts=getty@tty1.service

[Service]
User=KIOSK_USER_PLACEHOLDER
Group=KIOSK_USER_PLACEHOLDER
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/KIOSK_USER_PLACEHOLDER
WorkingDirectory=/home/KIOSK_USER_PLACEHOLDER
ExecStart=/usr/bin/startx /etc/kiosk/kiosk-launch.sh -- -nocursor -novtswitch vt1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
