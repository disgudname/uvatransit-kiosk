// UVA Transit kiosk boot splash. Shows the shield logo centered on a dark
// background with a progress bar underneath, driven by Plymouth's own boot
// progress estimate. Kept deliberately simple (no password dialog, no text
// messages) since this device never needs disk-unlock prompts.

Window.SetBackgroundTopColor(0.137, 0.176, 0.294);
Window.SetBackgroundBottomColor(0.137, 0.176, 0.294);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + (Window.GetWidth() / 2) - (logo.image.GetWidth() / 2);
logo.y = Window.GetY() + (Window.GetHeight() / 2) - (logo.image.GetHeight() / 2) - 30;
logo.sprite.SetPosition(logo.x, logo.y, 0);
logo.sprite.SetOpacity(1);

progress_box.image = Image("progress-box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetX() + (Window.GetWidth() / 2) - (progress_box.image.GetWidth() / 2);
progress_box.y = logo.y + logo.image.GetHeight() + 30;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

progress_bar.original_image = Image("progress-bar.png");
progress_bar.sprite = Sprite();
progress_bar.sprite.SetPosition(progress_box.x, progress_box.y, 1);

fun progress_callback(duration, progress) {
    progress_bar.image = progress_bar.original_image.Scale(Math.Int(progress_bar.original_image.GetWidth() * progress), progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
}

Plymouth.SetBootProgressFunction(progress_callback);

fun quit_callback() {
    logo.sprite.SetOpacity(0);
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
